# Custom Shirt Studio — Module 08 (Small Business Admin Dashboard)
# Copy to .env for local development and replace placeholder values.
# NEVER commit a real .env file or production secrets.

# Runtime environment: development | testing | production
APP_ENV=development

# Database URL (PostgreSQL in production; SQLite WAL supported in local dev/testing)
# Example PostgreSQL: postgresql+psycopg://db_user:db_pass@localhost:5432/css_module08_admin
DATABASE_URL=sqlite:///./module08_admin_dev.db

# Session & CSRF signing secret (MUST be >= 32 random chars in production)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_48

# Session & cookie security
SESSION_COOKIE_NAME=css_admin_session
SESSION_TTL_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=120
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Password hashing & login rate limiting
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Explicit CORS origins (comma-separated; wildcard '*' is forbidden in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External integration mode: live (mandatory in production) | mock_dev (local dev/tests only)
INTEGRATION_MODE=live

# External module base URLs (Phase 04+ adapters; leave blank when unconfigured)
UPSTREAM_CONNECT_TIMEOUT_SECONDS=2.0
UPSTREAM_READ_TIMEOUT_SECONDS=5.0
MODULE_01_BASE_URL=
MODULE_02_BASE_URL=
MODULE_02_ADMIN_API_KEY=
MODULE_05_BASE_URL=
MODULE_06_BASE_URL=
MODULE_07_BASE_URL=
MODULE_07_CONTRACT_VERIFIED=false
MODULE_07_SERVICE_BEARER_TOKEN=
